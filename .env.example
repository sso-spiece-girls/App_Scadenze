# --- Supabase (frontend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Access control (allowlist) ---
# Comma-separated emails allowed to sign in. Leave empty to use the default
# in src/lib/access.ts. The same list is enforced server-side by
# supabase/migrations/0002_allowlist.sql.
# VITE_ALLOWED_EMAILS=naldilisa568@gmail.com

# --- S-Kaupat / Coop.fi price lookup (Edge Function) ---
# Default Coop store used for price searches. Leave SKAUPAT_STORE_ID empty to
# auto-resolve the first store matching SKAUPAT_STORE_NAME.
# SKAUPAT_STORE_ID=
SKAUPAT_STORE_NAME=Lastra a Signa

# Overrides for the S-Kaupat persisted GraphQL query hashes (only needed if S-Group rotates them).
# SKAUPAT_HASH_PRODUCT_SEARCH=48756d592aa8fe6f1c9f560440bbdf8ce390ec3110fa34fc89b298c7d7a3bd4f
# SKAUPAT_HASH_STORE_SEARCH=e49317e01c3a57b286fadd6f3ea47fd1d64adebb483943ba0e229307d15763b5

# --- Web Push (VAPID) ---
# Generate with: npm run vapid
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com