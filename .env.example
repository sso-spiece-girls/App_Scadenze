# --- Supabase (frontend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Access control (allowlist) ---
# Comma-separated emails allowed to sign in. Leave empty to use the default
# in src/lib/access.ts. The same list is enforced server-side by
# supabase/migrations/0002_allowlist.sql.
# VITE_ALLOWED_EMAILS=naldilisa568@gmail.com

# --- Prices ---
# No automatic catalog price is fetched: the app targets Unicoop Firenze /
# Coop.fi, which exposes no public price API. Prices come from the receipt
# (OCR import) or are entered manually by the user.

# --- Web Push (VAPID) ---
# Generate with: npm run vapid
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com