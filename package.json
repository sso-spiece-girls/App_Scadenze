{
  "name": "app-scadenza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA per la gestione dei prodotti acquistati, delle scadenze e degli sprechi economici",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "vapid": "node scripts/generate-vapid.mjs",
    "db:generate": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@zxing/library": "^0.21.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "workbox-precaching": "^7.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
